# JABARI DENTAL — environment configuration (local development only).
#
# In production these are Cloudflare secrets, not env vars:
#   wrangler secret put AUTH_SECRET
#   wrangler secret put ADMIN_SECRET
#
# Never commit a real .env file. This file is a template.

# Admin authentication — required at build time (Cloudflare target) and at
# runtime. The password an administrator uses to log into /studio.
ADMIN_SECRET=change-me-in-production

# Secret used to sign session cookies. Use a long random string (32+ chars).
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Public origin serving the R2 bucket. Must match wrangler.toml [vars].
# During local dev this can be the r2.dev subdomain or any placeholder.
MEDIA_PUBLIC_BASE_URL=https://media.jabaridental.com

# Phone / WhatsApp / email / map URL / opening hours / etc. are NOT
# environment variables — they live in the Cloudflare D1 content store and
# are edited via the Studio CMS at /studio (see src/db/schema.ts). The
# studio reads them at request time, so no redeploy is needed.

# ---- Token-based deploy (scripts/deploy-rest.mjs) ----
# For CI / headless environments where you cannot run `wrangler login`.
# Generate the token at:
#   https://dash.cloudflare.com/profile/api-tokens
# with these permissions:
#   - Account > Workers Scripts: Edit
#   - Account > D1: Edit
#   - Account > R2: Edit
#   - Account > Account Settings: Read
#   - Zone (only if you'll attach a custom domain) > Workers Routes: Edit
# Treat the token like a password. Rotate at least yearly.
# CLOUDFLARE_API_TOKEN=

# Your Cloudflare account id. Find it at:
#   https://dash.cloudflare.com → click any zone / worker → URL contains /<id>/
# Or call `wrangler whoami` once you're logged in.
# CLOUDFLARE_ACCOUNT_ID=

# For local `wrangler dev` only. Production deploys use `wrangler deploy`.
# `wrangler dev` will read wrangler.toml bindings automatically.

# Set to "true" only if you terminate TLS upstream but Astro sees plain HTTP
# and you still want the admin session cookie marked Secure. NOT used in
# production — production runs behind Cloudflare which always presents HTTPS.
# FORCE_SECURE_COOKIE=true