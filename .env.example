# JABARI DENTAL — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Public-facing WhatsApp / call number (E.164, no plus sign is fine)
PUBLIC_PHONE=256770590299
PUBLIC_WHATSAPP=256770590299

# Admin authentication (server-side only)
# The password an administrator uses to log into /studio
ADMIN_SECRET=change-me-in-production
# Secret used to sign the session cookie (use a long random string)
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Base URL (used for absolute links, canonical, OG)
PUBLIC_SITE_URL=https://jabaridental.com

# Google Maps (verified) location
PUBLIC_MAPS_URL=https://maps.app.goo.gl/xb75PRmN25xptA1V7
