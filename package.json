{
  "name": "jabari-dental",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:cf": "wrangler dev",
    "build": "astro build --config astro.cloudflare.mjs",
    "preview": "astro preview --config astro.cloudflare.mjs",
    "deploy": "wrangler deploy",
    "deploy:rest": "node scripts/deploy-rest.mjs",
    "check": "astro check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:remote": "node scripts/seed-d1.mjs --remote",
    "db:seed:local": "node scripts/seed-d1.mjs --local",
    "import:json": "node scripts/import-json-to-d1.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:assets": "node scripts/gen-assets.mjs",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/sitemap": "^3.4.0",
    "astro": "^5.13.0",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "motion": "^12.23.0",
    "sharp": "^0.34.0",
    "shiki": "^4.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.28.1",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
