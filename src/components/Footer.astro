---
import type { SiteSettings, ContactSettings, DayHours } from "@/lib/types";
import { buildWhatsappUrl } from "@/lib/whatsapp";
import Icon from "@/components/Icon.astro";

interface Props {
  site: SiteSettings;
  contact: ContactSettings;
  hours: DayHours[];
}
const { site, contact, hours } = Astro.props;
const wa = buildWhatsappUrl(contact.whatsapp, "Hello JABARI DENTAL, I would like to enquire about an appointment.");
const tel = `tel:+${contact.phone}`;

const cols = [
  { title: "Explore", links: [
    { label: "Treatments", href: "/treatments" },
    { label: "Smile Gallery", href: "/gallery" },
    { label: "Patient Experience", href: "/patient-experience" },
    { label: "Articles", href: "/articles" },
  ]},
  { title: "Clinic", links: [
    { label: "About", href: "/about" },
    { label: "Contact", href: "/contact" },
    { label: "Book Appointment", href: "/book" },
    { label: "Privacy Policy", href: "/privacy" },
    { label: "Terms", href: "/terms" },
  ]},
];

const year = new Date().getFullYear();
---
<footer class="bg-forest-deep text-ivory">
  <div class="container-page py-16 md:py-24 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-4">
      <div class="font-display text-3xl text-ivory">{site.logoText}</div>
      <p class="mt-4 text-ivory/70 max-w-xs leading-relaxed">{site.tagline}</p>
      <p class="mt-4 text-ivory/55 text-sm">{contact.addressVerified}</p>
      <p class="text-ivory/45 text-xs mt-1">{contact.addressNote}</p>
    </div>

    {cols.map((c) => (
      <div class="md:col-span-2">
        <h3 class="eyebrow text-gold-soft">{c.title}</h3>
        <ul class="mt-5 space-y-3 text-sm">
          {c.links.map((l) => (
            <li>
              <a href={l.href} class="text-ivory/75 hover:text-ivory transition-colors">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="md:col-span-4">
      <h3 class="eyebrow text-gold-soft">Visit & Contact</h3>
      <ul class="mt-5 space-y-3 text-sm text-ivory/75">
        <li class="flex items-center gap-2"><Icon name="pin" size={16} class="text-gold-soft" /> <a href={contact.mapsUrl} target="_blank" rel="noopener" class="hover:text-ivory">{contact.addressVerified}</a></li>
        <li class="flex items-center gap-2"><Icon name="phone" size={16} class="text-gold-soft" /> <a href={tel} class="hover:text-ivory">+{contact.phone}</a></li>
        <li class="flex items-center gap-2"><Icon name="whatsapp" size={16} class="text-gold-soft" /> <a href={wa} target="_blank" rel="noopener" class="hover:text-ivory">WhatsApp</a></li>
        {contact.email && <li class="flex items-center gap-2"><Icon name="external" size={16} class="text-gold-soft" /> <a href={`mailto:${contact.email}`} class="hover:text-ivory">{contact.email}</a></li>}
      </ul>

      <h3 class="eyebrow text-gold-soft mt-8">Opening Hours</h3>
      <ul class="mt-4 space-y-1.5 text-sm text-ivory/70">
        {hours.map((h) => (
          <li class="flex justify-between gap-4 max-w-[14rem]">
            <span>{h.label}</span>
            <span class="tabular-nums text-ivory/55">{h.closed ? "Closed" : `${h.open}–${h.close}`}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-ivory/10">
    <div class="container-page py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-ivory/50">
      <span>© {year} {site.name}. All rights reserved.</span>
      <div class="flex items-center gap-5">
        <a href="/privacy" class="hover:text-ivory/80">Privacy</a>
        <a href="/terms" class="hover:text-ivory/80">Terms</a>
      </div>
    </div>
  </div>
</footer>
