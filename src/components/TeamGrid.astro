---
import type { TeamMember } from "@/lib/types";
import SmartImage from "@/components/SmartImage.astro";

interface Props {
  team: TeamMember[];
}
const { team } = Astro.props;
---
{team.length > 0 && (
  <section class="bg-ivory">
    <div class="container-page py-20 md:py-28">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">The team</p>
        <h2 class="display-section mt-4 text-balance">People who<br /><span class="italic text-forest">put you at ease.</span></h2>
      </div>
      <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14">
        {team.map((m, i) => (
          <article data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <div class="aspect-[4/5] overflow-hidden rounded-md">
              <SmartImage image={m.photo} imgClass="group-hover:scale-105 transition-transform duration-700" class="h-full" sizes="(min-width:1024px) 30vw, 90vw" />
            </div>
            <h3 class="font-display text-2xl mt-5 text-ink">{m.name}</h3>
            <p class="text-forest text-sm mt-1">{m.role}</p>
            {m.credentials && <p class="text-mist text-xs mt-1">{m.credentials}</p>}
            <p class="text-stone mt-3 leading-relaxed text-sm">{m.biography}</p>
            {m.specialties.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2">
                {m.specialties.map((s) => (
                  <li class="text-xs text-ink/60 border border-ink/15 rounded-full px-2.5 py-1">{s}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}
