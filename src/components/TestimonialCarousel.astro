---
import type { Testimonial } from "@/lib/types";
import Icon from "@/components/Icon.astro";

interface Props {
  testimonials: Testimonial[];
}
const { testimonials } = Astro.props;
---
{testimonials.length > 0 && (
  <section class="bg-forest-deep text-ivory">
    <div class="container-page py-20 md:py-28" data-testimonials data-items={JSON.stringify(
      testimonials.map((t) => ({ name: t.displayName, quote: t.quote, rating: t.rating }))
    )}>
      <div data-reveal class="text-center max-w-2xl mx-auto">
        <p class="eyebrow text-gold-soft">Patient experiences</p>
        <h2 class="display-section mt-4 text-balance">In their words.</h2>
      </div>

      <div class="mt-14 max-w-3xl mx-auto text-center relative min-h-[16rem]" data-t-stage>
        {testimonials.map((t, i) => (
          <blockquote
            data-t-slide
            class={`transition-opacity duration-700 absolute inset-0 flex flex-col items-center justify-center ${i === 0 ? "opacity-100" : "opacity-0 pointer-events-none"}`}
          >
            <Icon name="quote" size={34} class="text-gold-soft/70" />
            <p class="font-display text-2xl md:text-3xl leading-snug mt-5 text-balance">“{t.quote}”</p>
            <div class="flex items-center gap-1 mt-6 text-gold-soft" aria-label={`Rated ${t.rating} of 5`}>
              {Array.from({ length: 5 }).map((_, k) => <Icon name="star" size={15} class={k < t.rating ? "" : "opacity-30"} />)}
            </div>
            <p class="mt-3 text-ivory/70 text-sm tracking-wide uppercase">{t.displayName}</p>
          </blockquote>
        ))}
      </div>

      <div class="mt-10 flex items-center justify-center gap-6">
        <button type="button" data-t-prev class="w-11 h-11 rounded-full border border-ivory/30 inline-flex items-center justify-center hover:bg-ivory/10 transition-colors" aria-label="Previous testimonial">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="flex gap-2" data-t-dots>
          {testimonials.map((_, i) => (
            <button type="button" data-t-dot={String(i)} class={`w-2 h-2 rounded-full transition-colors ${i === 0 ? "bg-gold-soft" : "bg-ivory/30"}`} aria-label={`Go to testimonial ${i + 1}`}></button>
          ))}
        </div>
        <button type="button" data-t-next class="w-11 h-11 rounded-full border border-ivory/30 inline-flex items-center justify-center hover:bg-ivory/10 transition-colors" aria-label="Next testimonial">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </section>
)}

<script>
  function initTestimonials() {
    const root = document.querySelector("[data-testimonials]");
    if (!root) return;
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-t-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-t-dot]"));
    let cur = 0;
    function go(i: number) {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => {
        s.classList.toggle("opacity-100", idx === cur);
        s.classList.toggle("opacity-0", idx !== cur);
        s.classList.toggle("pointer-events-none", idx !== cur);
      });
      dots.forEach((d, idx) => {
        d.classList.toggle("bg-gold-soft", idx === cur);
        d.classList.toggle("bg-ivory/30", idx !== cur);
      });
    }
    root.querySelector("[data-t-prev]")?.addEventListener("click", () => go(cur - 1));
    root.querySelector("[data-t-next]")?.addEventListener("click", () => go(cur + 1));
    dots.forEach((d) => d.addEventListener("click", () => go(Number(d.dataset.tDot))));
    let timer = setInterval(() => go(cur + 1), 7000);
    root.addEventListener("mouseenter", () => clearInterval(timer));
  }
  initTestimonials();
</script>
