---
import type { Article } from "@/lib/types";
import ArticleCard from "@/components/ArticleCard.astro";

interface Props {
  articles: Article[];
  heading?: string;
  subheading?: string;
  showViewAll?: boolean;
}
const { articles, heading = "Latest Articles", subheading = "Careful, useful reading on oral health and your visit.", showViewAll = true } = Astro.props;
const [first, ...rest] = articles;
---
<section class="bg-ivory">
  <div class="container-page py-20 md:py-28">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow">Journal</p>
        <h2 class="display-section mt-4 text-balance">{heading}</h2>
        {subheading && <p class="lead mt-5 max-w-xl">{subheading}</p>}
      </div>
      {showViewAll && (
        <a href="/articles" class="shrink-0 inline-flex items-center gap-2 text-forest text-sm font-medium group">
          View all articles
          <span class="transition-transform duration-300 group-hover:translate-x-1"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
      )}
    </div>

    {first && (
      <div class="mt-14 space-y-16">
        <ArticleCard article={first} featured />
        {rest.length > 0 && (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14 pt-4 border-t hairline">
            {rest.map((a) => <ArticleCard article={a} />)}
          </div>
        )}
      </div>
    )}
  </div>
</section>
