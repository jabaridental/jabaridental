---
import type { SiteSettings, ContactSettings } from "@/lib/types";
import { getContactLinks } from "@/lib/whatsapp";
import Icon from "@/components/Icon.astro";

interface Props {
  site: SiteSettings;
  contact: ContactSettings;
}
const { site, contact } = Astro.props;

const nav = [
  { label: "Home", href: "/" },
  { label: "Treatments", href: "/treatments" },
  { label: "About", href: "/about" },
  { label: "Smile Gallery", href: "/gallery" },
  { label: "Patient Experience", href: "/patient-experience" },
  { label: "Articles", href: "/articles" },
  { label: "Contact", href: "/contact" },
];

const { tel, waHref, maps } = getContactLinks(
  contact.phone,
  contact.whatsapp,
  contact.mapsUrl,
  contact.email
);
---
<header class="sticky top-0 z-50 bg-ivory/85 backdrop-blur-md border-b hairline">
  <nav class="container-page flex items-center justify-between h-[var(--header-h)]" aria-label="Primary">
    <a href="/" class="flex items-baseline gap-2 group" aria-label={`${site.name} home`}>
      <span class="font-display text-xl md:text-2xl tracking-tight text-ink">{site.logoText}</span>
      <span class="text-[0.6rem] uppercase tracking-[0.3em] text-gold hidden sm:inline">Dental</span>
    </a>

    <ul class="hidden lg:flex items-center gap-8 text-sm text-charcoal/80">
      {nav.map((n) => (
        <li>
          <a
            href={n.href}
            class="relative py-2 inline-block after:content-[''] after:absolute after:left-0 after:-bottom-0.5 after:h-px after:w-0 after:bg-current after:transition-all after:duration-300 hover:after:w-full hover:text-ink"
          >
            {n.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden lg:flex items-center gap-2">
      <a
        href="/search"
        class="inline-flex items-center justify-center w-9 h-9 rounded-full hover:bg-ink/5 text-charcoal/80 hover:text-ink"
        aria-label="Search"
      >
        <Icon name="search" size={18} />
      </a>
      <a
        href={tel}
        class="inline-flex items-center gap-1.5 px-3 py-2 text-sm text-charcoal/80 hover:text-ink"
        aria-label="Call the clinic"
      >
        <Icon name="phone" size={16} /> <span class="hidden xl:inline">Call</span>
      </a>
      <a
        aria-label="WhatsApp the clinic"
      >
        <Icon name="whatsapp" size={16} /> <span class="hidden xl:inline">WhatsApp</span>
      </a>
      <a
        href={maps}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 px-3 py-2 text-sm text-charcoal/80 hover:text-ink"
        aria-label="Find the clinic"
      >
        <Icon name="pin" size={16} /> <span class="hidden xl:inline">Find Us</span>
      </a>
      <a
        href="/book"
        class="ml-1 inline-flex items-center gap-2 rounded-full bg-forest text-ivory px-5 py-2.5 text-sm font-medium hover:bg-forest-deep transition-colors"
      >
        Book Appointment
        <Icon name="arrow-right" size={15} />
      </a>
    </div>

    <button
      type="button"
      class="lg:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 text-ink"
      data-menu-open
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" size={26} />
    </button>
  </nav>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] bg-forest-deep text-ivory lg:hidden opacity-0 pointer-events-none transition-opacity duration-500"
  data-menu
>
  <div class="container-page flex items-center justify-between h-[var(--header-h)]">
    <span class="font-display text-2xl">{site.logoText}</span>
    <button
      type="button"
      class="inline-flex items-center justify-center w-11 h-11 -mr-2"
      data-menu-close
      aria-label="Close menu"
    >
      <Icon name="close" size={26} />
    </button>
  </div>
  <div class="container-page flex flex-col h-[calc(100%-var(--header-h))] justify-between pb-12">
    <ul class="flex flex-col gap-1 pt-8">
      {nav.map((n) => (
        <li>
          <a
            href={n.href}
            data-menu-link
            class="block font-display text-4xl md:text-5xl py-2 text-ivory/90 hover:text-gold-soft transition-colors"
          >
            {n.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="flex flex-col gap-3">
      <a
        href="/book"
        data-menu-link
        class="inline-flex items-center justify-center gap-2 rounded-full bg-ivory text-forest-deep px-6 py-4 text-base font-medium"
      >
        Book Appointment <Icon name="arrow-right" size={18} />
      </a>
      <div class="grid grid-cols-2 gap-3">
        <a
          href={waHref}
          target="_blank"
          rel="noopener"
          data-menu-link
          class="inline-flex items-center justify-center gap-2 rounded-full border border-ivory/30 px-4 py-3.5 text-sm"
        >
          <Icon name="whatsapp" size={18} /> WhatsApp
        </a>
        <a
          href={tel}
          data-menu-link
          class="inline-flex items-center justify-center gap-2 rounded-full border border-ivory/30 px-4 py-3.5 text-sm"
        >
          <Icon name="phone" size={18} /> Call
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const openBtn = document.querySelector("[data-menu-open]");
  const closeBtn = document.querySelector("[data-menu-close]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  function setMenu(open: boolean) {
    if (!menu) return;
    menu.classList.toggle("opacity-0", !open);
    menu.classList.toggle("pointer-events-none", !open);
    openBtn?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  }
  openBtn?.addEventListener("click", () => setMenu(true));
  closeBtn?.addEventListener("click", () => setMenu(false));
  menu?.querySelectorAll("[data-menu-link]").forEach((l) =>
    l.addEventListener("click", () => setMenu(false))
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
</script>
