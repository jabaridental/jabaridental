  "volume-on": `<path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 9a3.5 3.5 0 0 1 0 6M18.5 6.5a7 7 0 0 1 0 11"/>`,
  "volume-off": `<path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M22 9l-5 6M17 9l5 6"/>`,
};
const svg = ICONS[name] ? p(ICONS[name]) : p("");
---
