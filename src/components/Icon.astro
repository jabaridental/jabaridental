  close: `<path d="M6 6l12 12M18 6L6 18"/>`,
  clock: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>`,
  instagram: `<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="${s}" stroke="none"/>`,
  facebook: `<path d="M14 9V7c0-1 .5-1.5 1.5-1.5H17V3h-2.5C12 3 11 4.5 11 7v2H8v3h3v8h3v-8h2.5l.5-3H14z" fill="${s}" stroke="none"/>`,
  "chevron-down": `<path d="M6 9l6 6 6-6"/>`,
  search: `<circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/>`,
  check: `<path d="M5 13l4 4L19 7"/>`,
  calendar: `<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/>`,
  star: `<path d="M12 3l2.6 5.5 5.9.8-4.3 4.1 1.1 5.9L12 16.9 6.7 19.3l1.1-5.9L3.5 9.3l5.9-.8z" fill="${s}" stroke="none"/>`,
  plus: `<path d="M12 5v14M5 12h14"/>`,
  trash: `<path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"/>`,
  edit: `<path d="M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4"/>`,
  logout: `<path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 12h10M17 9l3 3-3 3"/>`,
  image: `<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M4 18l5-5 4 4 3-3 4 4"/>`,
